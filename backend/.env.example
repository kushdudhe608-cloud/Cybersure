# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
# Preferred: a single connection string (this is what hosted providers like
# Neon, Supabase, and Railway give you).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/cybersure
# Set to "true" for hosted Postgres providers that require SSL (Neon/Supabase/Railway)
PGSSL=false

# Alternative: skip DATABASE_URL and set these individually for a local install
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=cybersure

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
